# Local Supabase PostgreSQL connection. Use a URL-encoded password if it contains special characters.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable

# These must match the Node backend secrets to share JWT sessions.
JWT_ADMIN_SECRET=
JWT_PARENT_SECRET=

# Google OAuth web client ID used to verify Google ID tokens.
GOOGLE_OAUTH_CLIENT_ID=

# Gmail account and app password used to send parent verification codes.
GMAIL_USER=
GMAIL_APP_PASSWORD=

FRONTEND_URL=http://localhost:3000
API_PORT=8001
