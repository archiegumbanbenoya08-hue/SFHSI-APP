NODE_ENV=development
PORT=8000

# Local Supabase PostgreSQL connection. Use a URL-encoded password if it contains special characters.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres?sslmode=disable
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
PARENT_EMAIL=parent@example.com
PARENT_PASSWORD=
PARENT_ACCOUNT_PASSWORDS={}

# Generate unique secrets of at least 32 characters for these values.
JWT_ADMIN_SECRET=
JWT_PARENT_SECRET=
DEVICE_API_KEY=

# Absolute path to a Firebase service-account JSON file; keep this file out of Git.
GOOGLE_APPLICATION_CREDENTIALS=
# For hosted backends, store the complete service-account JSON in this secret instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Email Configuration (Gmail)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Server
SERVER_URL=http://localhost:8000
